---
import Base from '../layouts/Base.astro';
---
<Base title="Not found · Omkar Khadilkar">
  <section class="nf wrap">
    <p class="label">404</p>
    <h1>This page doesn't exist yet.</h1>
    <p class="sub">Some case studies are still being written. Everything live is on the home page.</p>
    <a class="btn" href="/">Back to home</a>
  </section>
</Base>

<style>
  .nf { padding-top: 120px; padding-bottom: 160px; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  h1 { font-size: clamp(32px, 4.5vw, 56px); letter-spacing: -0.03em; line-height: 1.1; }
  .sub { color: var(--muted); max-width: 32em; }
</style>
