---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import Slots from '../components/Slots.astro';
import Cover from '../components/visual/Cover.astro';
import GateFlow from '../components/visual/GateFlow.astro';
import Photo from '../components/Photo.astro';
import EvidenceTag from '../components/EvidenceTag.astro';
import { SITE, LINKS, CV, mailto } from '../config';
import { flagships, extras } from '../data/projects';
const live = flagships.filter((f) => f.ready && f.plain);
const gate = flagships.find((f) => f.gate)!.gate!;

// Until a case study page exists, links point to the project's row on this page.
const ready = new Set(flagships.filter((f) => f.ready).map((f) => f.slug));
// Escape, then turn **x** into <strong>x</strong>.
const rich = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const projectHref = (slug: string) => (ready.has(slug) ? `/work/${slug}/` : `#${slug}`);

const doors = [
  { title: "I'm hiring", line: 'Availability, roles, practicalities', href: '/hiring/' },
  { title: 'Show me the work', line: 'Every project, with its numbers', href: '/work/' },
  { title: 'I want the code', line: 'Code, tests and how each number was measured', href: LINKS.github, external: true },
  { title: 'Who is this?', line: 'Background and how I work', href: '/about/' },
];
---
<Base>
  <!-- 00 Hero: name, role, availability, proof and both calls to action fit the first screen -->
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-text">
        <p class="who reveal"><Photo size={44} class="hero-photo" /><span><span class="nm">{SITE.name}</span> · {SITE.pitch}</span></p>
        <p class="label eyebrow reveal">{SITE.location} · {SITE.study}</p>
        <h1 class="reveal">{SITE.tagline}</h1>
        <p class="lede reveal">
          I help data teams automate routine decisions and flag the ones a person must check. Simple rules
          handle the easy cases, AI only the hard ones, and every answer shows where it came from.
        </p>
        <div class="cta reveal">
          <a class="btn" href="/work/">View case studies</a>
          <a class="btn btn-outline" href={CV.href}>Download CV</a>
        </div>
      </div>
      <div class="hero-art reveal"><GateFlow {...gate} /></div>
      <p class="status"><span class="dot"></span><span>{SITE.seeking} · <a class="textlink" href={mailto()}>Email me</a></span></p>
    </div>
  </section>

  <!-- Proof: one measured number per flagship, straight under the hero -->
  <section class="proof-band" aria-labelledby="proof-h">
    <div class="wrap">
      <div class="proof-head">
        <h2 id="proof-h" class="label">Proof</h2>
        <p class="label shipped">Each number is measured, not estimated</p>
      </div>
      <ul class="proof">
        {live.map((f) => (
          <li data-kind={f.kind}>
            <a href={`/work/${f.slug}/`} class="metric">
              <span class="mtop"><span class="value">{f.plain!.count}</span><EvidenceTag level="measured" /></span>
              <span class="mlabel">{f.plain!.countLabel}</span>
              <span class="mcompare">{f.plain!.compare}</span>
              <span class="mproject label">{f.name} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 Flagships -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2 class="label"><span class="num">01</span> What I built</h2>
        <p class="label">Three projects, one idea · the case studies have the technical detail</p>
      </div>
      <div class="flagships">
        {live.map((f, i) => (
          <article class="flag" id={f.slug} data-kind={f.kind}>
            <div class="flag-text">
              <p class="label">{String(i + 1).padStart(2, '0')} · {f.kind}</p>
              <h3><a href={`/work/${f.slug}/`}>{f.name}</a></h3>
              <p class="problem">{f.plain!.problem}</p>
              <Slots slots={f.plain!.slots} name={f.name} />
            </div>
            <Cover slug={f.slug} index={i + 1} kind={f.kind} chart={{ type: 'dots', ...f.plain!.dots }}
              count={f.plain!.count} countLabel={f.plain!.countLabel} detail={f.plain!.detail}
              shot={f.plain!.shot} href={`/work/${f.slug}/`} />
            <div class="fpipe"><Pipeline stages={f.plain!.stages} title="How it works" keyLabel="only the hard cases reach this step" /></div>
          </article>
        ))}
        {extras.map((x, j) => (
          <article class="flag extra" id={`card-${x.slug}`} data-kind={x.kind} data-batch={x.batch} hidden>
            <div class="flag-text">
              <p class="label">{String(live.length + j + 1).padStart(2, '0')} · {x.kind}</p>
              <h3>{x.slots.how.href?.startsWith('/') ? <a href={x.slots.how.href}>{x.name}</a> : x.name}</h3>
              <p class="problem">{x.problem}</p>
              <Slots slots={x.slots} name={x.name} />
            </div>
            <Cover slug={x.slug} index={live.length + j + 1} kind={x.kind} chart={x.chart}
              count={x.count} countLabel={x.countLabel} detail={x.detail}
              shot={x.shot} href={x.slots.how.href} />
            <div class="fpipe"><Pipeline stages={x.stages} title="How it works" keyLabel={x.keyLabel} /></div>
          </article>
        ))}
      </div>
      <div class="more-wrap">
        <button type="button" id="more-btn" class="more-btn" aria-controls="work" hidden>
          <span class="more-txt">Show 3 more</span> <span class="more-arrow" aria-hidden="true">↓</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 02 Start here -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="label"><span class="num">02</span> Start here</h2>
        <p class="label">What are you looking for?</p>
      </div>
      <ul class="doors">
        {doors.map((d, i) => (
          <li>
            <a href={d.href} class="door" {...(d.external ? { rel: 'noopener' } : {})}>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <span class="dtitle">{d.title}</span>
              <span class="dline">{d.line}</span>
              <span class="arrow" aria-hidden="true">{d.external ? '↗' : '→'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 Currently -->
  <section class="section" id="now">
    <div class="wrap">
      <div class="section-head">
        <h2 class="label"><span class="num">03</span> Right now</h2>
      </div>
      <div class="now">
        <div><p class="label">Studying</p><p class="nowmain">M.Sc. Big Data & Business Analytics</p><p class="nowsub">FOM University of Applied Sciences, Essen</p></div>
        <div><p class="label">Building</p><p class="nowmain">faultline</p><p class="nowsub">A free tool that finds why a company's data broke, tested on 192 breakdowns I created on purpose</p></div>
        <div class="avail"><p class="label">Available</p><p class="nowmain">20 hours a week, from now</p><p class="nowsub">Werkstudent roles in applied AI and data · Essen, NRW or remote</p><a class="btn" href={mailto()}>Email me</a></div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Cards 04 to 09 load three at a time.
  const btn = document.getElementById('more-btn') as HTMLButtonElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('.flag.extra')];
  const batches = [...new Set(cards.map((c) => Number(c.dataset.batch)))].sort();
  let shown = 0;
  const render = () => {
    cards.forEach((c) => {
      const on = batches.indexOf(Number(c.dataset.batch)) < shown;
      c.hidden = !on;
    });
    if (!btn) return;
    const done = shown >= batches.length;
    btn.querySelector('.more-txt')!.textContent = done ? 'Show fewer' : 'Show 3 more';
    btn.querySelector('.more-arrow')!.textContent = done ? '↑' : '↓';
    btn.setAttribute('aria-expanded', String(shown > 0));
  };
  if (btn && cards.length) {
    btn.hidden = false;
    btn.addEventListener('click', () => {
      if (shown >= batches.length) {
        shown = 0;
        render();
        document.getElementById('work')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      shown += 1;
      render();
      const first = cards.find((c) => Number(c.dataset.batch) === batches[shown - 1]);
      first?.querySelector('a, h3')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    render();
  }
</script>

<style>
  section[id] { scroll-margin-top: 60px; }
  /* Hero */
  .hero { position: relative; overflow: hidden; background: var(--hero-tint); border-bottom: 1px solid var(--rule); }
  .hero-in {
    position: relative; padding-top: 48px; padding-bottom: 24px;
    display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 16px 56px; align-items: center;
    grid-template-areas: 'text art' 'status status';
  }
  .hero-text { grid-area: text; min-width: 0; }
  .hero-art { grid-area: art; justify-self: end; width: 100%; max-width: 440px; }
  .who { font-size: clamp(18px, 1.6vw, 22px); letter-spacing: -0.01em; color: var(--muted); display: flex; align-items: center; gap: 12px; }
  .who :global(.hero-photo) { width: 44px; height: 44px; }
  .who .nm { color: var(--ink); font-weight: 500; }
  .eyebrow { margin: 6px 0 20px; }
  h1 {
    font-size: clamp(34px, 4.2vw, 60px); line-height: 1.05; letter-spacing: -0.035em;
    max-width: 15em; text-wrap: balance;
  }
  .lede { max-width: 34em; color: var(--muted); font-size: 18px; margin-top: 22px; }
  .lede code { font-family: var(--mono); font-size: 0.9em; color: var(--ink); border-bottom: 1px solid var(--accent); }
  .cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 24px; }
  .status { grid-area: status; margin-top: 12px; padding-top: 14px; border-top: 1px solid var(--rule); display: flex; align-items: flex-start; gap: 10px; font-size: 16px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); display: inline-block; flex-shrink: 0; margin-top: 0.6em; }

  /* Proof */
  .proof-band { padding: 4px 0 56px; }
  .proof-head { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0 12px; }
  .proof-head p { color: var(--muted); }
  .mcompare { font-size: 14px; color: var(--muted); }
  .proof { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule); }
  .proof li + li { border-left: 1px solid var(--rule); }
  .metric { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 18px 20px 18px; text-decoration: none; height: 100%; border-top: 3px solid var(--tone); }
  .metric:hover { background: color-mix(in srgb, var(--tone) 6%, var(--bg)); }
  .mtop { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; }
  .value { font-size: clamp(30px, 3.4vw, 48px); line-height: 1; letter-spacing: -0.03em; color: var(--tone); }
  .mlabel { font-size: 14px; line-height: 1.45; color: var(--muted); flex: 1; }
  .mproject { color: var(--ink); }
  .metric:hover .mproject { color: var(--tone); }

  /* How I build */
  .run { margin: 28px 0 0; padding: 22px 24px; background: var(--surface); border: 1px solid var(--rule); display: grid; grid-template-columns: 1fr; gap: 14px; }
  .run-m { display: none; }
  .run-h { font-size: 20px; letter-spacing: -0.01em; margin-top: 6px; }
  .legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 14px; color: var(--muted); }
  .lg { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; vertical-align: -1px; }
  .lg.mute { background: var(--muted); opacity: 0.45; }
  .lg.fill { background: var(--accent); }
  .lg.hollow { border: 1.5px solid var(--ink); }

  /* Doors */
  .doors { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--rule); }
  .doors li + li { border-left: 1px solid var(--rule); }
  .door { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 20px 20px 28px; min-height: 170px; text-decoration: none; }
  .door:hover { background: var(--surface); }
  .door:hover .arrow { color: var(--accent); transform: translateX(3px); }
  .dtitle { font-size: 22px; letter-spacing: -0.01em; margin-top: auto; }
  .dline { font-size: 14px; color: var(--muted); }
  .arrow { position: absolute; top: 18px; right: 20px; font-family: var(--mono); transition: transform 0.15s; }

  /* Flagships */
  .flagships { display: flex; flex-direction: column; }
  .flag { scroll-margin-top: 80px; display: grid; grid-template-columns: 4fr 7fr; gap: 40px; padding: 32px 0; border-top: 1px solid var(--rule); align-items: center; }
  .flag:first-child { border-top: none; padding-top: 0; }
  .flag h3 { font-size: 32px; letter-spacing: -0.02em; margin: 10px 0 8px; }
  .flag h3 a { text-decoration: none; }
  .flag h3 a:hover { color: var(--tone); }
  .problem { font-size: 18px; line-height: 1.5; max-width: 30em; margin-top: 4px; }
  .fpipe { grid-column: 1 / -1; }
  .flag[hidden] { display: none; }
  .more-wrap { display: flex; justify-content: center; padding-top: 28px; border-top: 1px solid var(--rule); }
  .more-btn { font: inherit; font-family: var(--mono); font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); background: var(--bg); border: 1px solid var(--rule-strong); border-radius: 999px; padding: 10px 20px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center; }
  .more-btn:hover { border-color: var(--accent); color: var(--accent); }
  .more-arrow { font-size: 15px; }
  .result { border-left: 2px solid var(--accent); padding: 6px 0 6px 28px; }
  .rcount { font-size: clamp(44px, 5vw, 72px); line-height: 1; letter-spacing: -0.035em; margin-top: 10px; }
  .rlabel { font-size: 17px; margin-top: 10px; max-width: 26em; }
  .rdetail { font-size: 15px; color: var(--muted); margin-top: 12px; max-width: 32em; line-height: 1.5; }
  .outcome { margin-top: 14px; font-size: 16px; line-height: 1.5; max-width: 30em; }
  .outcome :global(strong) { font-weight: 500; color: var(--accent); font-size: 1.15em; }
  .fstatus { margin-top: 18px; }
  .flinks { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 18px; }

  /* Ledger */
  .note { color: var(--muted); font-size: 14px; }

  /* Now */
  .now { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--rule); }
  .now > div { padding: 24px; display: flex; flex-direction: column; gap: 6px; }
  .now > div + div { border-left: 1px solid var(--rule); }
  .nowmain { font-size: 20px; margin-top: 10px; }
  .nowsub { color: var(--muted); font-size: 14px; }
  .avail { background: var(--surface); }
  .avail .btn { align-self: flex-start; margin-top: 16px; }

  @media (max-width: 1000px) {
    .doors { grid-template-columns: repeat(2, 1fr); }
    .doors li:nth-child(3) { border-left: none; }
    .doors li:nth-child(n + 3) { border-top: 1px solid var(--rule); }
    .flag { grid-template-columns: 1fr; gap: 28px; }
    .hero-in { grid-template-columns: 1fr; grid-template-areas: 'text' 'status' 'art'; gap: 8px; }
    .hero-art { justify-self: start; max-width: 400px; margin-top: 12px; }
    .run-d { display: none; }
    .run-m { display: block; }
    .result { padding-left: 18px; }
  }
  @media (max-width: 720px) {
    .hero-in { padding-top: 28px; padding-bottom: 16px; }
    .eyebrow { display: none; }
    h1 { margin-top: 12px; }
    .lede { font-size: 16px; margin-top: 16px; }
    .cta { margin-top: 18px; }
    .status { margin-top: 18px; font-size: 15px; }
    .proof-head p { display: none; }
    .proof { grid-template-columns: 1fr; }
    .proof li + li { border-left: none; border-top: 1px solid var(--rule); }
    .metric { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; align-items: baseline; padding: 12px 4px; }
    .mtop { width: auto; grid-row: span 2; flex-direction: column; align-items: flex-start; gap: 6px; }
    .value { font-size: 30px; }
    .doors { grid-template-columns: 1fr; }
    .doors li + li { border-left: none; border-top: 1px solid var(--rule); }
    .door { min-height: 0; padding: 18px 20px; }
    .dtitle { margin-top: 4px; font-size: 19px; }
    .now { grid-template-columns: 1fr; }
    .now > div + div { border-left: none; border-top: 1px solid var(--rule); }
    .flag h3 { font-size: 26px; }
  }
  @media (max-width: 420px) {
    .mlabel { font-size: 13px; }
  }
</style>
