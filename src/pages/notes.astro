---
import Base from '../layouts/Base.astro';
import { SUBSTACK } from '../config';
import { getPosts } from '../lib/substack';

const posts = await getPosts();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Notes · Omkar Khadilkar" description="A weekly build log, every Tuesday: the backstory of each project, what broke, and what the numbers say.">
  <section class="head wrap">
    <p class="label">Notes</p>
    <h1>A build log, every Tuesday.</h1>
    <p class="sub">
      One post a week on Substack: the backstory of a project, what broke, and what the numbers say. The case
      studies on this site are the finished version; the notes are the working version.
    </p>
    <div class="cta">
      <a class="btn" href={SUBSTACK.profile} rel="noopener">Read on Substack ↗</a>
      <a class="textlink" href="/rss.xml">RSS feed</a>
    </div>
  </section>

  <section class="wrap list">
    {posts.length > 0 ? (
      <ol class="posts">
        {posts.map((p) => (
          <li>
            <a href={p.link} rel="noopener">
              <time class="label" datetime={p.date.toISOString()}>{fmt(p.date)}</time>
              <span class="pt">{p.title}</span>
              {p.summary && <span class="ps">{p.summary}</span>}
              <span class="go mono" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">
        Posts are on <a href={SUBSTACK.profile} rel="noopener">Substack</a> for now. They will be listed here too.
      </p>
    )}
  </section>
</Base>

<style>
  .head { padding-top: 88px; padding-bottom: 48px; }
  h1 { font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.035em; line-height: 1.05; margin: 16px 0 16px; }
  .sub { color: var(--muted); max-width: 36em; font-size: 18px; }
  .cta { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 28px; }
  .list { padding-bottom: 96px; }
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule-strong); }
  .posts a { display: grid; grid-template-columns: 140px 1fr 24px; column-gap: 20px; row-gap: 4px; padding: 20px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .posts a:hover .pt { color: var(--accent); }
  time { padding-top: 5px; grid-row: span 2; }
  .pt { font-size: 21px; letter-spacing: -0.015em; }
  .ps { color: var(--muted); font-size: 15px; grid-column: 2; }
  .go { grid-column: 3; grid-row: 1; color: var(--muted); text-align: right; }
  .empty { color: var(--muted); border-top: 1px solid var(--rule-strong); padding-top: 24px; }
  @media (max-width: 720px) {
    .posts a { grid-template-columns: 1fr 24px; }
    time { grid-row: auto; grid-column: 1; }
    .pt, .ps { grid-column: 1; }
    .go { grid-row: 1; grid-column: 2; }
  }
</style>
