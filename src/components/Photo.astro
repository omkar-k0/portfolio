---
// Omkar's photo. Renders nothing until SITE.photo is set in config.ts, so no empty frame ever ships.
import { SITE } from '../config';
interface Props { size: number; class?: string }
const { size, class: cls } = Astro.props;
---
{SITE.photo && (
  <img data-photo class:list={['photo', cls]} src={SITE.photo} alt={`${SITE.name}, portrait`} width={size} height={size} decoding="async" />
)}
<style>
  .photo { border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 1px solid var(--rule-strong); background: var(--surface); }
</style>
