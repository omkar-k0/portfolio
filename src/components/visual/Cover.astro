---
import DotGrid from './DotGrid.astro';
import Glyph from './Glyph.astro';
interface Props {
  slug: string; index: number; kind: string;
  total: number; hit: number; cols: number;
  count: string; countLabel: string; detail: string;
}
const { slug, index, kind, total, hit, cols, count, countLabel, detail } = Astro.props;
const tone = kind === 'Open source' ? 'oss' : 'product';
---
<div class={`cover ${tone}`}>
  <div class="ctop">
    <span class="pill label">{kind}</span>
    <span class="big" aria-hidden="true" data-n={String(index).padStart(2, '0')}></span>
  </div>
  <Glyph slug={slug} />
  <div class="res">
    <p class="rcount">{count}</p>
    <p class="rlabel">{countLabel}</p>
    <DotGrid total={total} filled={hit} cols={cols} size={total > 100 ? 9 : 13} label={`${count} ${countLabel}`} />
    <p class="rdetail">{detail}</p>
  </div>
</div>
<style>
  .cover { --tone: var(--accent); position: relative; overflow: hidden; background: color-mix(in srgb, var(--tone) 9%, var(--bg)); border: 1px solid color-mix(in srgb, var(--tone) 30%, transparent); padding: 22px 26px 26px; display: grid; grid-template-columns: 200px 1fr; gap: 10px 32px; align-items: start; }
  .cover.oss { --tone: var(--accent-2); }
  .ctop { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: flex-start; height: 22px; }
  .pill { border: 1px solid var(--tone); color: var(--ink); background: var(--bg); padding: 3px 10px; border-radius: 999px; }
  .big { position: absolute; right: 18px; top: 4px; font-size: 96px; line-height: 1; letter-spacing: -0.05em; color: var(--tone); opacity: 0.12; pointer-events: none; }
  .big::before { content: attr(data-n); }
  .res { position: relative; }
  .rcount { font-size: clamp(40px, 4.2vw, 60px); line-height: 1; letter-spacing: -0.035em; }
  .rlabel { font-size: 16px; margin: 8px 0 14px; max-width: 28em; }
  .rdetail { font-size: 14.5px; color: var(--muted); margin-top: 14px; max-width: 34em; line-height: 1.5; }
  .res :global(.dots) { --tone: inherit; }
  @media (max-width: 1100px) {
    .cover { grid-template-columns: 1fr; }
    .cover :global(.glyph) { max-width: 200px; }
  }
  @media (max-width: 720px) { .cover { padding: 18px 18px 22px; } .big { font-size: 72px; } }
</style>
