---
import DotGrid from './DotGrid.astro';
import Glyph from './Glyph.astro';
import type { Chart, Shot } from '../../data/projects';
interface Props {
  slug: string; index: number; kind: string; chart: Chart;
  count: string; countLabel: string; detail: string;
  shot?: Shot; href?: string;
}
const { slug, index, kind, chart, count, countLabel, detail, shot, href } = Astro.props;
const dotSize = chart.type === 'dots' ? (chart.total > 300 ? 7 : chart.total > 100 ? 9 : 13) : 0;
---
<div class="cover lift" data-kind={kind}>
  <div class="ctop">
    <span class="pill label">{kind}</span>
    <span class="big" aria-hidden="true" data-n={String(index).padStart(2, '0')}></span>
  </div>
  {shot
    ? <a class="shot" href={href ?? shot.src} tabindex="-1"><img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" /></a>
    : <Glyph slug={slug} />}
  <div class="res">
    <p class="rcount">{count}</p>
    <p class="rlabel">{countLabel}</p>
    {chart.type === 'dots' && <DotGrid total={chart.total} filled={chart.hit} cols={chart.cols} size={dotSize} label={`${count} ${countLabel}`} />}
    {chart.type === 'bar' && (
      <div class="bar" role="img" aria-label={`${chart.pct}% of the whole`}>
        <span class="barfill" style={`width:${chart.pct}%`}></span>
        <span class="barlab label" style={`left:calc(${chart.pct}% + 8px)`}>{chart.pct}%</span>
      </div>
    )}
    <p class="rdetail">{detail}</p>
  </div>
</div>
<style>
  .cover { position: relative; overflow: hidden; background: color-mix(in srgb, var(--tone) 9%, var(--bg)); border: 1px solid color-mix(in srgb, var(--tone) 30%, transparent); padding: 22px 26px 26px; display: grid; grid-template-columns: 220px 1fr; gap: 10px 32px; align-items: start; }
  .shot { display: block; align-self: start; margin-top: 8px; border: 1px solid color-mix(in srgb, var(--tone) 40%, transparent); background: var(--bg); line-height: 0; }
  .shot img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .bar { position: relative; height: 22px; background: var(--bg); border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent); max-width: 420px; }
  .barfill { position: absolute; inset: 0 auto 0 0; background: var(--tone); }
  .barlab { position: absolute; top: 3px; color: var(--ink); }
  .ctop { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: flex-start; height: 22px; }
  .pill { border: 1px solid var(--tone); color: var(--ink); background: var(--bg); padding: 3px 10px; border-radius: 999px; }
  .big { position: absolute; right: 18px; top: 4px; font-size: 96px; line-height: 1; letter-spacing: -0.05em; color: var(--tone); opacity: 0.12; pointer-events: none; }
  .big::before { content: attr(data-n); }
  .res { position: relative; }
  .rcount { font-size: clamp(40px, 4.2vw, 60px); line-height: 1; letter-spacing: -0.035em; }
  .rlabel { font-size: 16px; margin: 8px 0 14px; max-width: 28em; }
  .rdetail { font-size: 14.5px; color: var(--muted); margin-top: 14px; max-width: 34em; line-height: 1.5; }
  .res :global(.dots) { --tone: inherit; }
  @media (max-width: 1100px) {
    .cover { grid-template-columns: 1fr; }
    .cover :global(.glyph) { max-width: 200px; }
    .shot { max-width: 360px; }
  }
  @media (max-width: 720px) { .cover { padding: 18px 18px 22px; } .big { font-size: 72px; } }
</style>
