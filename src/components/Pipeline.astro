---
import type { Stage } from '../data/projects';
interface Props { stages: Stage[]; facts?: string[]; title?: string; keyLabel?: string }
const { stages, facts, title = 'Pipeline', keyLabel = 'handles the ambiguous rest' } = Astro.props;
---
<figure class="pipe">
  <figcaption class="label head">
    <span>{title}</span>
    <span class="key"><i></i> {keyLabel}</span>
  </figcaption>
  <ol class="stages" style={`--n:${stages.length}`}>
    {stages.map((s, i) => (
      <li class={s.escalation ? 'stage esc' : 'stage'}>
        <span class="idx">{String(i + 1).padStart(2, '0')}</span>
        <span class="name">{s.label}</span>
        <span class="detail">{s.detail}</span>
      </li>
    ))}
  </ol>
  {facts && facts.length > 0 && (
    <ul class="facts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
  )}
</figure>

<style>
  .pipe { margin: 0; background: var(--surface); border: 1px solid var(--rule); padding: 20px; }
  .head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .key { display: inline-flex; align-items: center; gap: 6px; text-transform: none; letter-spacing: 0; }
  .key i { width: 10px; height: 10px; background: var(--accent); display: inline-block; }
  .stages {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 18px;
  }
  .stage {
    position: relative; border: 1px solid var(--rule-strong); background: var(--bg);
    padding: 12px 12px 14px; display: flex; flex-direction: column; gap: 4px; min-height: 104px;
  }
  .stage:not(:last-child)::after {
    content: '→'; position: absolute; right: -9px; top: 50%; transform: translate(50%, -50%);
    font-family: var(--mono); font-size: 12px; color: var(--muted); line-height: 1; z-index: 1;
  }
  .idx { font-family: var(--mono); font-size: 10.5px; color: var(--muted); }
  .name { font-size: 15px; font-weight: 500; }
  .detail { font-size: 13px; line-height: 1.4; color: var(--muted); }
  .esc { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .esc .idx, .esc .detail { color: var(--accent-ink); opacity: 0.85; }
  .facts {
    list-style: none; margin: 16px 0 0; padding: 12px 0 0; border-top: 1px solid var(--rule);
    display: flex; flex-wrap: wrap; gap: 6px 20px; font-family: var(--mono); font-size: 12px; color: var(--muted);
  }
  @media (max-width: 900px) {
    .head { flex-direction: column; gap: 6px; }
    .stages { grid-template-columns: 1fr; gap: 14px; }
    .stage { min-height: 0; flex-direction: row; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .detail { flex-basis: 100%; }
    .stage:not(:last-child)::after { content: '↓'; right: auto; left: 18px; top: auto; bottom: -14px; transform: none; padding: 0 2px; }
  }
</style>
