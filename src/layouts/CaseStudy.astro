---
import Base from './Base.astro';
import EvidenceTag from '../components/EvidenceTag.astro';
import { caseStudyChain, type Metric } from '../data/projects';
import { CV, mailto } from '../config';

interface Props {
  title: string;
  question: string;
  description: string;
  crumb: string; // e.g. "Work · Product · 01"
  links: { label: string; href: string; primary?: boolean }[];
  metrics: Metric[];
  facts: { label: string; value: string }[];
  toc: { id: string; label: string }[];
  stack: string[];
  // Three lines that answer what, how well, and my role before any prose.
  tldr: { why?: string; problem: string; result: string; role: string };
  // Exact commands to rerun the numbers on this page. Rendered as the last section.
  reproduce?: { repo: string; commands: string; files: { path: string; what: string }[]; note?: string };
}
const { title, question, description, crumb, links, metrics, facts, toc, stack, tldr, reproduce } = Astro.props;
// Previous / Next follow the work index, over the projects that have a Case study.
const { prev, next } = caseStudyChain(Astro.url.pathname);
const fullToc = reproduce ? [...toc, { id: 'reproduce', label: 'Reproduce it' }] : toc;
// The crumb starts with the Project kind ("Open source · 02"); it sets the page's colour.
const kind = crumb.split(' · ')[0];
---
<Base title={`${title} · Case study · Omkar Khadilkar`} description={description}>
  <div class="progress" data-progress data-kind={kind} aria-hidden="true" hidden></div>
  <article class="cs" data-kind={kind}>
    <header class="cs-head" data-kind={kind}>
     <div class="wrap">
      <p class="label crumb"><i class="sw" aria-hidden="true"></i><a href="/#work">Work</a> · {crumb}</p>
      <h1>{title}</h1>
      <p class="q">{question}</p>
      <div class="cs-links">
        {links.map((l) => (
          <a class={l.primary ? 'btn' : 'textlink'} href={l.href} rel="noopener">{l.label}{l.primary ? '' : ' ↗'}</a>
        ))}
      </div>
     </div>
    </header>

    <div class="wrap">
      <div class="tldr">
        <p class="label tldr-h">In 30 seconds</p>
        <dl>
          {tldr.why && <div><dt class="label">Why a company cares</dt><dd>{tldr.why}</dd></div>}
          <div><dt class="label">Problem</dt><dd>{tldr.problem}</dd></div>
          <div><dt class="label">Result</dt><dd>{tldr.result}</dd></div>
          <div><dt class="label">My role</dt><dd>{tldr.role}</dd></div>
        </dl>
      </div>
      <ul class="tiles">
        {metrics.map((m) => (
          <li>
            <EvidenceTag level={m.evidence} source={m.source} />
            <span class={m.evidence === 'pending' ? 'tval pending' : 'tval'}>{m.value}</span>
            <span class="tlabel">{m.label}</span>
          </li>
        ))}
      </ul>
      <dl class="facts">
        {facts.map((f) => (<div><dt class="label">{f.label}</dt><dd>{f.value}</dd></div>))}
      </dl>
    </div>

    <div class="wrap layout">
      <nav class="toc" aria-label="On this page">
        <details open>
          <summary class="label">On this page</summary>
          <ol>
            {fullToc.map((t, i) => (<li><a href={`#${t.id}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span> {t.label}</a></li>))}
          </ol>
        </details>
      </nav>
      <div class="prose">
        <slot />
        {reproduce && (
          <section id="reproduce">
            <h2><span class="num">{String(fullToc.length).padStart(2, '0')}</span>Reproduce it</h2>
            <p>Every number on this page comes from these commands, run in <a href={reproduce.repo} rel="noopener">the repository</a>.</p>
            <pre class="repro"><code>{reproduce.commands}</code></pre>
            <table>
              <thead><tr><th>File</th><th>What it holds</th></tr></thead>
              <tbody>{reproduce.files.map((r) => <tr><td class="n">{r.path}</td><td>{r.what}</td></tr>)}</tbody>
            </table>
            {reproduce.note && <p class="caption">{reproduce.note}</p>}
          </section>
        )}
      </div>
    </div>

    <footer class="wrap cs-foot">
      <aside class="cs-contact">
        <div>
          <p class="label">Hiring for applied AI or data?</p>
          <p class="cc-line">I'm looking for a 20-hour/week Werkstudent role in Essen, NRW or remote, available now. Happy to walk you through {title} on a call.</p>
        </div>
        <div class="cc-btns">
          <a class="btn" href={mailto(`About ${title} – Werkstudent role`)}>Email me</a>
          <a class="btn btn-outline" href={CV.href}>Download CV</a>
        </div>
      </aside>
      <div class="stack">
        <p class="label">Built with</p>
        <ul>{stack.map((s) => <li>{s}</li>)}</ul>
      </div>
      <nav class="pn" aria-label="More case studies">
        {prev ? <a href={prev.href}><span class="label">← Previous</span>{prev.label}</a> : <span />}
        <a href="/#work" class="all"><span class="label">All work</span>Back to the flagships</a>
        {next ? <a href={next.href} class="right"><span class="label">Next →</span>{next.label}</a> : <span />}
      </nav>
    </footer>
  </article>
</Base>

<script>
  // Reading progress: 0 at the top, 1 once the contact block starts to come into view.
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const end = document.querySelector<HTMLElement>('.cs-contact');
  if (bar && end) {
    bar.hidden = false;
    let queued = false;
    const update = () => {
      queued = false;
      const stop = end.getBoundingClientRect().top + window.scrollY - window.innerHeight;
      const p = stop <= 0 ? 1 : Math.min(1, Math.max(0, window.scrollY / stop));
      bar.style.transform = `scaleX(${p})`;
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    // Images that load late change the page height without a scroll event.
    new ResizeObserver(queue).observe(document.body);
    update();
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 60; background: var(--tone); transform-origin: 0 50%; transform: scaleX(0); pointer-events: none; }
  .progress[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) { .progress { transition: transform 0.08s linear; } }
  .cs-head { background: color-mix(in srgb, var(--tone) 7%, var(--bg)); border-bottom: 1px solid color-mix(in srgb, var(--tone) 25%, transparent); margin-bottom: 40px; }
  .sw { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--tone); margin-right: 8px; }
  .cs-head > .wrap { padding-top: 80px; padding-bottom: 40px; }
  .crumb a { text-decoration: none; }
  .crumb a:hover { color: var(--accent); }
  h1 { font-size: clamp(40px, 6vw, 80px); letter-spacing: -0.035em; line-height: 1.02; margin: 18px 0 16px; max-width: 14em; }
  .q { font-size: clamp(19px, 2vw, 24px); color: var(--muted); font-style: italic; max-width: 32em; }
  .cs-links { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 32px; }

  .tldr { margin: 0 0 28px; padding: 18px 20px; background: var(--surface); border: 1px solid var(--rule); border-left: 3px solid var(--tone); }
  .tldr-h { color: var(--tone); margin: 0 0 12px; }
  .tldr dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px 24px; margin: 0; align-items: start; }
  .tldr dl > div { min-width: 0; }
  .tldr dd { margin: 6px 0 0; font-size: 15px; line-height: 1.45; }
  .repro { background: var(--surface); border: 1px solid var(--rule); padding: 16px 18px; overflow-x: auto; font-family: var(--mono); font-size: 13px; line-height: 1.6; margin: 0 0 20px; max-width: 100%; }
  .repro code { background: none; border: none; padding: 0; font-size: inherit; }
  .cs-contact { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; border: 1px solid var(--rule); border-left: 3px solid var(--tone); padding: 22px 24px; margin-bottom: 40px; background: color-mix(in srgb, var(--tone) 5%, var(--bg)); }
  .cc-line { font-size: 18px; margin-top: 8px; max-width: 34em; }
  .cc-btns { display: flex; gap: 14px; flex-wrap: wrap; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .tiles li { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 22px 20px; }
  .tiles li + li { border-left: 1px solid var(--rule); }
  .tval { font-size: clamp(34px, 3.6vw, 48px); line-height: 1; letter-spacing: -0.03em; margin-top: 10px; }
  .tval.pending { color: var(--muted); }
  .tlabel { font-size: 14px; color: var(--muted); line-height: 1.45; }

  .facts { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin: 0; border-bottom: 1px solid var(--rule); }
  .facts div { padding: 16px 20px 18px 0; }
  .facts dd { margin: 6px 0 0; font-size: 14px; line-height: 1.45; }

  .layout { display: grid; grid-template-columns: 3fr 7fr 2fr; gap: 24px; padding-top: 64px; padding-bottom: 40px; }
  .toc { position: sticky; top: 84px; align-self: start; }
  .toc summary { list-style: none; cursor: default; margin-bottom: 14px; }
  .toc summary::-webkit-details-marker { display: none; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; border-left: 1px solid var(--rule); }
  .toc a { display: block; padding-left: 14px; font-size: 14px; text-decoration: none; color: var(--muted); }
  .toc a:hover { color: var(--ink); }
  .toc .mono { font-size: 11px; color: var(--accent); margin-right: 4px; }

  .prose { min-width: 0; }
  .prose :global(section) { scroll-margin-top: 80px; padding-bottom: 48px; }
  .prose :global(section + section) { border-top: 1px solid var(--rule); padding-top: 40px; }
  .prose :global(h2) { font-size: 28px; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 18px; }
  .prose :global(h2 .num) { font-family: var(--mono); font-size: 13px; color: var(--accent); vertical-align: middle; margin-right: 10px; letter-spacing: 0; }
  .prose :global(h3) { font-size: 18px; font-weight: 500; margin: 28px 0 8px; }
  .prose :global(p) { margin: 0 0 16px; max-width: 66ch; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 22px; max-width: 66ch; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.88em; background: var(--surface); border: 1px solid var(--rule); padding: 1px 5px; border-radius: 2px; }
  .prose :global(.callout) { border-left: 2px solid var(--accent); background: var(--surface); padding: 20px 24px; font-size: 20px; line-height: 1.45; letter-spacing: -0.01em; max-width: 34em; margin: 0 0 16px; }
  .prose :global(.caption) { font-family: var(--mono); font-size: 12px; color: var(--muted); margin-top: 12px; max-width: 70ch; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 8px 0 20px; font-size: 15px; }
  .prose :global(th) { text-align: left; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); font-weight: 400; padding: 0 12px 10px 0; border-bottom: 1px solid var(--rule-strong); }
  .prose :global(td) { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .prose :global(td.n) { font-family: var(--mono); white-space: nowrap; }
  .prose :global(.shot) { margin: 4px 0 28px; }
  .prose :global(.shot img) { display: block; width: 100%; height: auto; border: 1px solid var(--rule-strong); border-radius: 2px; }
  .prose :global(.shot a:hover img) { border-color: var(--accent); }
  .prose :global(.term) { border: 1px solid var(--rule-strong); border-radius: 2px; background: var(--surface); }
  .prose :global(.term-bar) { text-transform: none; letter-spacing: 0; margin: 0; padding: 10px 16px; border-bottom: 1px solid var(--rule); color: var(--muted); max-width: none; }
  .prose :global(.term pre) { margin: 0; padding: 14px 16px; overflow-x: auto; font-family: var(--mono); font-size: 12.5px; line-height: 1.55; }
  .prose :global(.term pre code) { background: none; border: none; padding: 0; font-size: inherit; }
  .prose :global(.term .caption) { padding: 0 16px 12px; }
  .prose :global(.decisions) { display: grid; gap: 14px; margin-top: 8px; }
  .prose :global(.decision) { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--rule); }
  .prose :global(.decision > div) { padding: 16px 18px; }
  .prose :global(.decision > div + div) { border-left: 1px solid var(--rule); background: var(--surface); }
  .prose :global(.decision .label) { display: block; margin-bottom: 6px; }
  .prose :global(.decision strong) { font-weight: 500; }
  .prose :global(.decision p) { margin: 8px 0 0; font-size: 15px; color: var(--muted); }

  .cs-foot { padding-bottom: 72px; }
  .stack { border-top: 1px solid var(--rule); padding-top: 24px; }
  .stack ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .stack li { font-family: var(--mono); font-size: 12px; border: 1px solid var(--rule-strong); padding: 4px 9px; border-radius: 2px; }
  .pn { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; margin-top: 40px; border: 1px solid var(--rule); }
  .pn a { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; text-decoration: none; }
  .pn a:hover { background: var(--surface); }
  .pn > * + * { border-left: 1px solid var(--rule); }
  .pn .right { text-align: right; align-items: flex-end; }

  @media (max-width: 1000px) {
    .tiles { grid-template-columns: repeat(2, 1fr); }
    .tiles li:nth-child(3) { border-left: none; }
    .tiles li:nth-child(n + 3) { border-top: 1px solid var(--rule); }
    .facts { grid-template-columns: repeat(2, 1fr); }
    .tldr dl { grid-template-columns: 1fr; gap: 12px; }
    .layout { grid-template-columns: 1fr; padding-top: 32px; }
    .toc { position: static; border: 1px solid var(--rule); padding: 14px 16px; }
    .toc summary { cursor: pointer; margin-bottom: 0; }
    .toc details[open] summary { margin-bottom: 12px; }
  }
  @media (max-width: 720px) {
    .cs-head > .wrap { padding-top: 48px; }
    .prose :global(.decision) { grid-template-columns: 1fr; }
    .prose :global(.decision > div + div) { border-left: none; border-top: 1px solid var(--rule); }
    .pn { grid-template-columns: 1fr; }
    .pn > * + * { border-left: none; border-top: 1px solid var(--rule); }
    .pn .right { text-align: left; align-items: flex-start; }
    .prose :global(table) { font-size: 13px; }
  }
</style>
